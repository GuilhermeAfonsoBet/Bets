[Unit]
Description=BetinAsia Bot - Scraping e Coleta de Dados
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
Environment="PATH=/home/betbot/venv/bin"
ExecStart=/home/betbot/venv/bin/python main.py --collect
Restart=always
RestartSec=30

# Logs
StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/bot.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/bot_error.log

# Limites
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
