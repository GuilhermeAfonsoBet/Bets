{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betinasia.local/schemas/h3bup_daily_v2_schema.json",
  "title": "H3BUP Daily V2 Canonical Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "report_type",
    "report_date_utc",
    "window_start_utc",
    "window_end_utc",
    "report_cutoff_utc",
    "generated_at_utc",
    "policy_id",
    "policy_version",
    "source_manifest",
    "report_health",
    "execution_funnel",
    "settlement",
    "performance",
    "latency",
    "clv",
    "methodology"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "report_type": { "enum": ["DAILY_CLOSED", "INTRADAY"] },
    "report_date_utc": { "type": "string", "format": "date" },
    "window_start_utc": { "type": "string" },
    "window_end_utc": { "type": "string" },
    "report_cutoff_utc": { "type": "string" },
    "generated_at_utc": { "type": "string" },
    "git_commit": { "type": ["string", "null"] },
    "policy_id": { "type": "string" },
    "policy_version": { "type": "string" },
    "policy_fingerprint": { "type": ["string", "null"] },
    "source_manifest": { "type": "object" },
    "report_health": { "type": "object" },
    "operations_health": { "type": "object" },
    "data_quality": { "type": "object" },
    "statistical_readiness": { "type": "object" },
    "execution_funnel": { "type": "object" },
    "settlement": { "type": "object" },
    "performance": {
      "type": "object",
      "required": ["roi_settled", "roiw_total_v1", "roiw_total_v2"]
    },
    "latency": { "type": "object" },
    "clv": {
      "type": "object",
      "required": ["fair_edge"]
    },
    "concentration": { "type": "object" },
    "exceptions": { "type": "array" },
    "methodology": { "type": "object" }
  }
}
