[Unit]
Description=BetinAsia H3B Audit (WS gate Back) - decide Back via WS(t0,t+5)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment="PATH=/home/betbot/Bets/betinasia_bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:99"
Environment="PYTHONUNBUFFERED=1"

# Override apenas para este serviço (WS-only; não abre betslip)
Environment="AUDIT_EXECUTOR_WORKERS=2"
Environment="AUDIT_TEMPORAL_WORKERS=0"
Environment="AUDIT_MAX_QUEUE_DEPTH=200"
Environment="AUDIT_MAX_QUEUE_WAIT_MS=20000"
Environment="AUDIT_MODE=ws_gate_back"
Environment="GATE_RISE_OFFSET_SEC=5"
Environment="GATE_RISE_RATIO=1.02"
# Regime ws_gate_back instantâneo (aprova no T+0; coleta pontos em paralelo)
Environment="GATE_BACK_ENFORCE_RISE_FILTER=0"
Environment="GATE_BACK_MEASURE_OFFSETS_SEC=0"
Environment="AUDIT_GATE_BACK_ASYNC_MEASURE_WORKERS=1"

ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStart=/home/betbot/Bets/betinasia_bot/venv/bin/python audit_h3b_api.py --direction up --mode ws_gate_back
Restart=always
RestartSec=20

StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/audit_ws_gate_back.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/audit_ws_gate_back_error.log

TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target

