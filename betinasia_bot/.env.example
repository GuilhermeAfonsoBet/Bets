# ============================================
# BETINASIA BOT - Configurações
# ============================================
# Copie este arquivo para .env e preencha os valores

# ===========================================
# BETINASIA - Credenciais de Login
# ===========================================
BETINASIA_USERNAME=seu_usuario_aqui
BETINASIA_PASSWORD=sua_senha_aqui

# ===========================================
# BANCO DE DADOS - PostgreSQL
# ===========================================
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://betbot:sua_senha_segura@localhost:5432/betinasia_bot

# ===========================================
# RESULTADOS - API-Football (api-sports.io)
# ===========================================
# Necessário para preencher placares em `matches` e liberar ROI no relatório.
# Crie/obtenha a chave em api-sports.io e preencha abaixo.
API_FOOTBALL_KEY=

# ===========================================
# CACHE - Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# TELEGRAM - Alertas (opcional)
# ===========================================
# Crie um bot em @BotFather e obtenha o token
TELEGRAM_BOT_TOKEN=
# Seu chat ID (envie /start ao bot e veja o ID)
TELEGRAM_CHAT_ID=

# ===========================================
# PROXY RESIDENCIAL (para VPS em datacenter)
# ===========================================
# Necessário para evitar bloqueio de IP pelo BetinAsia
# Serviços: Bright Data, IPRoyal, Smartproxy, Oxylabs
# Exemplo proxy estático ISP:
# PROXY_SERVER=http://200.160.37.95:12323
# PROXY_USERNAME=seu_user_proxy
# PROXY_PASSWORD=sua_senha_proxy
PROXY_SERVER=http://brd.superproxy.io:33335
PROXY_USERNAME=brd-customer-XXXXX-zone-residential_proxy1
PROXY_PASSWORD=sua_senha_proxy

# ===========================================
# SCRAPING - Configurações
# ===========================================
# Intervalo entre scrapes (segundos)
SCRAPE_INTERVAL_TIER1=30
SCRAPE_INTERVAL_TIER2=120
SCRAPE_INTERVAL_TIER3=300

# Modo headless do browser (true para produção)
BROWSER_HEADLESS=true

# ===========================================
# SCORING - Modelo
# ===========================================
# Diretório dos modelos .joblib
MODELS_DIR=./models

# Cutoff de probabilidade para aprovar aposta
SCORING_CUTOFF=0.62

# ===========================================
# EXECUÇÃO - Apostas
# ===========================================
# Modo simulação (true = não aposta de verdade)
DRY_RUN=true

# Stake base em unidades
BASE_STAKE=10.0

# Stake máximo por aposta
MAX_STAKE=100.0

# ===========================================
# EXECUTOR (dryrun/live) — serviço local
# ===========================================
# Importante: LIVE confirma aposta real via /v1/orders/.
EXECUTOR_ALLOW_LIVE=0
EXECUTOR_WORKERS=1
EXECUTOR_QUEUE_MAX=200
EXECUTOR_CAP_WINDOW_SEC=300
EXECUTOR_CAP_MAX=50
EXECUTOR_JSONL=logs/executor_live.jsonl
EXECUTOR_RESULT_TTL_SEC=3600

# Preferível usar unix socket (mais rápido, não expõe porta)
EXECUTOR_UNIX_SOCKET=/tmp/betinasia-exec.sock
# (alternativa) HTTP local
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=8089

# LIVE v0 (comece pequeno)
EXECUTOR_LIVE_CCY=USD
EXECUTOR_LIVE_STAKE=3.0
EXECUTOR_LIVE_MAX_STAKE=3.0
EXECUTOR_LIVE_EXCHANGE_MODE=make_and_take

# FAST_PMM (trade-off: velocidade vs “best odd”)
EXECUTOR_FAST_PMM=1
EXECUTOR_PMM_TIMEOUT_SEC=0.8
EXECUTOR_PMM_MIN_WAIT_SEC=0.0
EXECUTOR_PMM_IDLE_TIMEOUT_SEC=0.12

# Cache de betslips no executor (reutiliza refresh do mesmo betslip_id).
# IMPORTANTE: manter muitos betslips abertos pode causar HTTP_403 too_many_open_betslips.
# Para validação estatística em shadow, recomenda-se começar com 0 (sem cache + cleanup).
EXECUTOR_BETSLIP_CACHE_MAX_KEYS=0

# Quando ocorrer HTTP_403 too_many_open_betslips, espera antes de re-tentar.
EXECUTOR_TOO_MANY_OPEN_RETRY_SLEEP_SEC=0.6

# Goto robustez (startup): evita travar esperando "load"
EXECUTOR_GOTO_WAIT_UNTIL=domcontentloaded
EXECUTOR_GOTO_TIMEOUT_MS=45000
# Se 1, falha o worker se não conseguir `goto` (default 0 = continua).
EXECUTOR_GOTO_STRICT=0

# Login (proxy-friendly)
BETINASIA_LOGIN_POST_WAIT_SEC=12
BETINASIA_MOLLY_CLIENT_VERSION=2.5.54

# ===========================================
# EXECUTOR BRIDGE (Audit -> Executor)
# ===========================================
# Comece em shadow (is_live=false) e só depois ligue live.
BRIDGE_MODE=shadow
BRIDGE_EXEC_SIDE=Back
BRIDGE_STAKE=3.0
BRIDGE_POLL_SEC=2.0
BRIDGE_LOOKBACK_SEC=120
BRIDGE_MAX_PER_CYCLE=3
BRIDGE_HYPOTHESIS=H3B
BRIDGE_PREMATCH_ONLY=1

# (opcional) Policy OOS (walk-forward) exportado pelo relatório.
# Gere com: analyze_contexto_operacao_b808_robust_report.py --walkforward --wf-export-policy-json /caminho/policy.json
BRIDGE_POLICY_JSON=
BRIDGE_POLICY_RELOAD_SEC=5.0
# Se `WF_KEY_BY_LEAGUE=1` estiver ativo no export e você quiser ignorar liga operacionalmente:
BRIDGE_POLICY_USE_BASE=0

# (opcional) Guardrail simples por liquidez (proxy = betslip_limit em USD)
BRIDGE_MIN_LIMIT=0.0

# (opcional) Engine dinâmico de sizing por jogo (match_budget do WF exportado na policy JSON).
# Quando ligado, o bridge calcula stake/liability por sinal usando:
# - budgets do WF: budget_back_frac / budget_lay_frac / budget_cap_signal_frac / budget_risk_mode
# - banca vigente (via accounting_daily_report.json ou override)
BRIDGE_USE_WF_BUDGET=0
# Fonte de banca (arquivo gerado pelo betinasia-accounting-daily.service):
BRIDGE_BANKROLL_JSON=logs/accounting_daily_report.json
BRIDGE_BANKROLL_RELOAD_SEC=30.0
# Override manual (se setar, prevalece como referência de sizing):
# BRIDGE_BANKROLL_REF=1000
# Estimativa de #sinais por jogo para modes signals_sqrt/signals_linear (janela curta):
BRIDGE_SIGNALS_LOOKBACK_H=36.0
# Override manual do risk_mode do WF (não depende do daily/policy):
# BRIDGE_WF_RISK_MODE_OVERRIDE=signals_sqrt
# Overrides manuais dos parâmetros numéricos de risco/caps (separado do daily):
# Crie um arquivo JSON (ex.: logs/bridge_risk_params.json) e aponte aqui para poder ajustar
# sem depender do wf_policy_current.json:
BRIDGE_RISK_PARAMS_JSON=
BRIDGE_RISK_PARAMS_RELOAD_SEC=5.0
# Opcional: parâmetros adicionais para sizing base por liquidez (betslip_limit).
# - stake_pct_of_limit: usa X% do betslip_limit como base antes do budget (default=1.0).
# - stake_cap_abs: teto absoluto (USD) para essa base (0=sem teto).
# Exemplo no JSON: {"stake_pct_of_limit": 1.0, "stake_cap_abs": 0}
# Guardrail adicional: cap por jogo como % da banca (0=off). Back em stake; Lay em liability.
BRIDGE_CAP_EVENT_BACK_FRAC=0.0
BRIDGE_CAP_EVENT_LAY_FRAC=0.0

# ===========================================
# ACCOUNTING monitor (saldo + P&L via CSV)
# ===========================================
ACCOUNTING_POLL_SEC=300
ACCOUNTING_OUT_DIR=logs/accounting
ACCOUNTING_JSONL=logs/accounting_snapshots.jsonl

# ===========================================
# DAILY FULL REPORT (OOS + execution + accounting + PDF + Telegram)
# ===========================================
DAILY_REPORT_TELEGRAM=1
DAILY_REPORT_OUT_DIR=logs/daily_reports
DAILY_REPORT_MODE=oos_first
DAILY_OOS_DIRECTION=up
DAILY_OOS_VERSIONS=v4.0-api,v5.0-ws-only,v5.1-ws-gate-lay
# (opcional) auditoria API back-only para alimentar execução Back
# DAILY_OOS_VERSIONS=v4.0-api,v5.2-api-back,v5.1-ws-gate-lay
DAILY_OOS_LOOKBACK_DAYS=21
# Se 1, não remove dias “auto-excluídos” (útil para enxergar janelas até o fim mesmo com betslip=0 em alguns dias)
DAILY_NO_AUTO_EXCLUDE_DAYS=0
# Walk-forward defaults alinhados com o reporte “v38” (expanding + leaguePre + AHgatePre)
DAILY_WF_TRAIN_MODE=expanding
DAILY_WF_TRAIN_DAYS=2
DAILY_WF_TEST_DAYS=2
DAILY_WF_STEP_DAYS=2
DAILY_WF_KEY_BY_LEAGUE=1
DAILY_WF_KEY_BY_LEAGUE_SCOPE=pre
DAILY_WF_AH_MAX_ABS_LINE=2.0
DAILY_WF_AH_SCOPE=pre
DAILY_WF_LIQUIDITY_MODE=none
DAILY_WF_LIQUIDITY_SCOPE=pre
DAILY_WF_MIN_MATCHES=0
DAILY_WF_SHRINKAGE=1
DAILY_WF_EXCLUDE_EXEC_BUCKETS_BACK=10-20s
DAILY_KELLY_BANKROLL=10000
# (opcional) se vazio, usa default do script (10k,20k,30k,50k,100k quando kelly_bankroll setado)
DAILY_WF_BANKROLL_GRID=
DAILY_WF_POLICY_CURRENT=logs/wf_policy_current.json
DAILY_WF_POLICY_HISTORY_DIR=logs/policy_history
DAILY_WF_POLICY_HISTORY_JSONL=logs/wf_policy_history.jsonl
DAILY_EXEC_KPI_LAST=50000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/betinasia_bot.log

# ===========================================
# AMBIENTE
# ===========================================
# development, staging, production
ENVIRONMENT=development

# ===========================================
# AUDIT API (H3B) — Gate WS(t0,t+5) -> abre LAY sob cap
# ===========================================
# Modo do audit_h3b_api.py:
# - api        : WS detecta + abre BACK/LAY via betslip (alto custo/rate limit)
# - ws_only    : só WS (não abre ticket)
# - ws_gate_lay: só abre ticket LAY quando houver queda forte em 5s (recomendado)
AUDIT_MODE=ws_gate_lay
AUDIT_API_SIDES=both

# Gate: WS(t+offset) < ratio * WS(t0)
GATE_DROP_OFFSET_SEC=5
GATE_DROP_RATIO=0.98

# Cap de aberturas (POST /v1/betslips/) — conservador para evitar throttling
GATE_OPEN_WINDOW_SEC=300
GATE_OPEN_MAX=3

# Opcional: após abrir ticket LAY, coletar pontos via refresh
# (isso aumenta chamadas; use com parcimônia)
# GATE_LAY_REFRESH_TIMES_SEC=0,5,10,15,20

# ===========================================
# OOS (walk-forward) — export operacional
# ===========================================
# Path para export JSON (usado pelo Decision Engine/Bridge)
WF_EXPORT_POLICY_JSON=
