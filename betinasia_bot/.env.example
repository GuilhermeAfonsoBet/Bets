# ============================================
# BETINASIA BOT - Configurações
# ============================================
# Copie este arquivo para .env e preencha os valores

# ===========================================
# BETINASIA - Credenciais de Login
# ===========================================
BETINASIA_USERNAME=seu_usuario_aqui
BETINASIA_PASSWORD=sua_senha_aqui

# ===========================================
# BANCO DE DADOS - PostgreSQL
# ===========================================
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://betbot:sua_senha_segura@localhost:5432/betinasia_bot

# ===========================================
# RESULTADOS - API-Football (api-sports.io)
# ===========================================
# Necessário para preencher placares em `matches` e liberar ROI no relatório.
# Crie/obtenha a chave em api-sports.io e preencha abaixo.
API_FOOTBALL_KEY=

# ===========================================
# CACHE - Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# TELEGRAM - Alertas (opcional)
# ===========================================
# Crie um bot em @BotFather e obtenha o token
TELEGRAM_BOT_TOKEN=
# Seu chat ID (envie /start ao bot e veja o ID)
TELEGRAM_CHAT_ID=

# ===========================================
# PROXY RESIDENCIAL (para VPS em datacenter)
# ===========================================
# Necessário para evitar bloqueio de IP pelo BetinAsia
# Serviços: Bright Data, IPRoyal, Smartproxy, Oxylabs
# Exemplo proxy estático ISP:
# PROXY_SERVER=http://200.160.37.95:12323
# PROXY_USERNAME=seu_user_proxy
# PROXY_PASSWORD=sua_senha_proxy
PROXY_SERVER=http://brd.superproxy.io:33335
PROXY_USERNAME=brd-customer-XXXXX-zone-residential_proxy1
PROXY_PASSWORD=sua_senha_proxy

# ===========================================
# SCRAPING - Configurações
# ===========================================
# Intervalo entre scrapes (segundos)
SCRAPE_INTERVAL_TIER1=30
SCRAPE_INTERVAL_TIER2=120
SCRAPE_INTERVAL_TIER3=300

# Modo headless do browser (true para produção)
BROWSER_HEADLESS=true

# ===========================================
# SCORING - Modelo
# ===========================================
# Diretório dos modelos .joblib
MODELS_DIR=./models

# Cutoff de probabilidade para aprovar aposta
SCORING_CUTOFF=0.62

# ===========================================
# EXECUÇÃO - Apostas
# ===========================================
# Modo simulação (true = não aposta de verdade)
DRY_RUN=true

# Stake base em unidades
BASE_STAKE=10.0

# Stake máximo por aposta
MAX_STAKE=100.0

# ===========================================
# EXECUTOR (dryrun/live) — serviço local
# ===========================================
# Importante: LIVE confirma aposta real via /v1/orders/.
EXECUTOR_ALLOW_LIVE=0
EXECUTOR_WORKERS=1
EXECUTOR_QUEUE_MAX=200
EXECUTOR_CAP_WINDOW_SEC=300
EXECUTOR_CAP_MAX=50
EXECUTOR_JSONL=logs/executor_live.jsonl
EXECUTOR_RESULT_TTL_SEC=3600
#
# Heartbeat opcional no JSONL (para medir gaps como downtime real).
# 0 = desligado (padrão histórico). Recomendado em LIVE: 60.
EXECUTOR_JSONL_HEARTBEAT_SEC=0

# Preferível usar unix socket (mais rápido, não expõe porta)
EXECUTOR_UNIX_SOCKET=/tmp/betinasia-exec.sock
# (alternativa) HTTP local
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=8089

# LIVE v0 (comece pequeno)
EXECUTOR_LIVE_CCY=USD
EXECUTOR_LIVE_STAKE=3.0
EXECUTOR_LIVE_MAX_STAKE=3.0
EXECUTOR_LIVE_EXCHANGE_MODE=make_and_take

# ===========================================
# Staking operacional (BACK): por bucket de slippage_pre_pct
# ===========================================
# Se 1, o executor sobrescreve stake em LIVE para BACK:
# - slippage_pre_pct < EXECUTOR_BACK_STAKE_SLIP_NEG_LIMIT_PCT      -> EXECUTOR_BACK_STAKE_SLIP_NEG
# - entre [NEG_LIMIT, POS_LIMIT]                                    -> EXECUTOR_BACK_STAKE_SLIP_MID
# - slippage_pre_pct > EXECUTOR_BACK_STAKE_SLIP_POS_LIMIT_PCT      -> EXECUTOR_BACK_STAKE_SLIP_POS
#
# Regra solicitada:
# - stake 40 para slippage_pre_pct < -2%
# - stake 20 para slippage_pre_pct entre -2% e +2%
EXECUTOR_BACKPRE_FAST_STAKE_ENABLE=0
EXECUTOR_BACK_STAKE_SIZING_ENABLE=0
EXECUTOR_BACK_STAKE_SLIP_NEG_LIMIT_PCT=-2.0
EXECUTOR_BACK_STAKE_SLIP_POS_LIMIT_PCT=2.0
EXECUTOR_BACK_STAKE_SLIP_NEG=40
EXECUTOR_BACK_STAKE_SLIP_MID=20
EXECUTOR_BACK_STAKE_SLIP_POS=20
#
# Compat/legado (fallback): mantidos para retrocompatibilidade.
EXECUTOR_BACKPRE_FAST_MAX_PRE_SUBMIT_MS=5000
EXECUTOR_BACKPRE_FAST_MAX_SLIPPAGE_PCT=2.0
EXECUTOR_BACKPRE_FAST_STAKE_HI=20
EXECUTOR_BACKPRE_FAST_STAKE_LO=1.50
# Gate de aprovação no PRE (default ativo):
# - slippage_pre_pct deve ser ESTRITAMENTE menor que o limiar (default 0.0)
# - com FAIL_CLOSED=1, ausência de slippage também bloqueia
EXECUTOR_BACKPRE_FAST_APPROVAL_GATE_ENABLE=1
EXECUTOR_BACKPRE_FAST_APPROVAL_MAX_SLIPPAGE_PCT=0.0
EXECUTOR_BACKPRE_FAST_APPROVAL_FAIL_CLOSED=1
# Gate opcional por latência (pre_submit_ms): executa LIVE BACK somente se <= X segundos.
EXECUTOR_BACK_LATENCY_GATE_ENABLE=0
EXECUTOR_BACK_LATENCY_GATE_MAX_SEC=8.0

# ===========================================
# Value sizing (Back In): stake 20 vs 2
# ===========================================
# Se 1, aplica stake dinâmico para BACK em modo in-play:
# - calcula pre_submit_ms = agora - req.created_at (decision engine)
# - calcula slippage_pre_pct = (odd_pre_submit - odd_at_decision)/odd_at_decision * 100
# Se (pre_submit_ms<=5000) AND (slippage_pre_pct>=2.0) -> stake_hi (default 20); senão stake_lo (default 2).
#
# IMPORTANTE:
# - Ajuste EXECUTOR_LIVE_MAX_STAKE para >= stake_hi (ex.: 20), senão vai bloquear com LIVE_STAKE_TOO_HIGH.
EXECUTOR_BACKIN_VALUE_STAKE_ENABLE=0
EXECUTOR_BACKIN_VALUE_MAX_PRE_SUBMIT_MS=5000
EXECUTOR_BACKIN_VALUE_MIN_SLIP_PCT=2.0
EXECUTOR_BACKIN_VALUE_STAKE_HI=20
EXECUTOR_BACKIN_VALUE_STAKE_LO=2

# FAST_PMM (trade-off: velocidade vs “best odd”)
EXECUTOR_FAST_PMM=1
EXECUTOR_PMM_TIMEOUT_SEC=0.8
EXECUTOR_PMM_MIN_WAIT_SEC=0.0
EXECUTOR_PMM_IDLE_TIMEOUT_SEC=0.12
# Mitigação "No PMMs received": retry 1x com timeout mais folgado + restart se WS stale
EXECUTOR_NO_PMMS_RETRY_ENABLE=1
EXECUTOR_NO_PMMS_RETRY_TIMEOUT_MULT=2.0
EXECUTOR_NO_PMMS_RETRY_TIMEOUT_FLOOR_SEC=1.6
EXECUTOR_NO_PMMS_RETRY_MIN_WAIT_SEC=0.15
EXECUTOR_NO_PMMS_RETRY_IDLE_TIMEOUT_SEC=0.25
EXECUTOR_NO_PMMS_RETRY_SLEEP_SEC=0.2
EXECUTOR_NO_PMMS_FORCE_RESTART=1
EXECUTOR_NO_PMMS_WS_STALE_MS=12000
# Timeout para receber betslip_id (API/WS)
EXECUTOR_BETSLIP_ID_TIMEOUT_SEC=3.0

# Cache de betslips no executor (reutiliza refresh do mesmo betslip_id).
# IMPORTANTE: manter muitos betslips abertos pode causar HTTP_403 too_many_open_betslips.
# Para validação estatística em shadow, recomenda-se começar com 0 (sem cache + cleanup).
EXECUTOR_BETSLIP_CACHE_MAX_KEYS=0

# Quando ocorrer HTTP_403 too_many_open_betslips, espera antes de re-tentar.
EXECUTOR_TOO_MANY_OPEN_RETRY_SLEEP_SEC=0.6
# Quantos betslips tentar fechar em lote ao detectar 403 too_many_open_betslips
EXECUTOR_TOO_MANY_OPEN_CLEANUP_MAX=12
# Timeout (s) por close_betslip no cleanup em lote
EXECUTOR_TOO_MANY_OPEN_CLOSE_TIMEOUT_SEC=1.2

# Goto robustez (startup): evita travar esperando "load"
EXECUTOR_GOTO_WAIT_UNTIL=domcontentloaded
EXECUTOR_GOTO_TIMEOUT_MS=45000
# Se 1, falha o worker se não conseguir `goto` (default 0 = continua).
EXECUTOR_GOTO_STRICT=0

# Auto-healing do executor (Playwright/sessão)
# Em alguns dias o browser/sessão pode travar (ex.: "Execution context was destroyed", HTTP_401/auth_error).
# Esses parâmetros permitem que o próprio executor reinicie a sessão/browsers automaticamente.
EXECUTOR_AUTO_RESTART_ENABLE=1
# Cooldown entre restarts automáticos (segundos)
EXECUTOR_AUTO_RESTART_COOLDOWN_SEC=120
# Rate limit: máximo de restarts automáticos por hora (por worker)
EXECUTOR_AUTO_RESTART_MAX_PER_HOUR=6
# Se ocorrerem N falhas seguidas (API_FAILED/NO_SESSION), força restart mesmo sem string "fatal"
EXECUTOR_AUTO_RESTART_FAIL_STREAK=3

# ===========================================
# EXECUTOR housekeeping (leve/forte) — reduzir overhead fora do ApiBetslipClient
# ===========================================
# O objetivo é reduzir `call_minus_total_ms` / overhead local acumulado em runs longos.
# Regras:
# - Housekeeping leve roda intervalado e deve ser barato (GC de caches + opcionalmente fechar UI/caches).
# - Housekeeping forte (restart de sessão) fica DESLIGADO por padrão para evitar loops; ligue só quando necessário.
EXECUTOR_HOUSEKEEP_ENABLE=1
#
# Leve: roda a cada N segundos (pós-request) com best-effort.
EXECUTOR_HOUSEKEEP_LIGHT_EVERY_SEC=10
# GC dos caches internos do ApiBetslipClient (sync/rápido)
EXECUTOR_HOUSEKEEP_LIGHT_GC_ENABLE=1
#
# (Opcional) fechar betslip visível no UI (Playwright evaluate). Pode ajudar a reduzir acúmulo no front.
# Em geral mantenha 0; ligue se observar UI “entupida”/lenta em run longo.
EXECUTOR_HOUSEKEEP_LIGHT_UI_CLOSE_ENABLE=0
EXECUTOR_HOUSEKEEP_LIGHT_UI_EVERY_SEC=60
EXECUTOR_HOUSEKEEP_LIGHT_UI_CLOSE_TIMEOUT_SEC=0.35
#
# (Opcional) fechar betslips cacheados e limpar o cache local.
# Só faz sentido se EXECUTOR_BETSLIP_CACHE_MAX_KEYS>0.
EXECUTOR_HOUSEKEEP_LIGHT_CLOSE_CACHE_ENABLE=0
EXECUTOR_HOUSEKEEP_LIGHT_CLOSE_CACHE_EVERY_SEC=120
EXECUTOR_HOUSEKEEP_LIGHT_CLOSE_CACHE_MAX=6
EXECUTOR_HOUSEKEEP_LIGHT_CLOSE_CACHE_TIMEOUT_SEC=0.9
#
# Forte: restart controlado da sessão/browser quando o overhead local degrada (p50 numa janela local).
# Default: 0 (desligado).
EXECUTOR_HOUSEKEEP_STRONG_ENABLE=0
# Janela local (N últimos requests) usada para p50 dos sinais de degradação
EXECUTOR_HOUSEKEEP_STRONG_WINDOW_N=50
# Mínimo de eventos na janela para considerar trigger
EXECUTOR_HOUSEKEEP_STRONG_MIN_EVENTS=20
# Trigger 1: overhead_local_ms p50 >= limiar (ms)
EXECUTOR_HOUSEKEEP_STRONG_OVERHEAD_P50_MS=6000
# Trigger 2: call_minus_total_ms p50 >= limiar (ms)
EXECUTOR_HOUSEKEEP_STRONG_CALL_MINUS_TOTAL_P50_MS=10000
# Cooldown entre restarts fortes (segundos)
EXECUTOR_HOUSEKEEP_STRONG_COOLDOWN_SEC=900

# ===========================================
# OPS Monitor / Auto-pilot (health_monitor)
# ===========================================
# Serviços (systemd) para o health_monitor checar/reiniciar em auto-pilot.
# Você pode desativar um check setando para "0" ou "none".
EXECUTOR_SERVICE=betinasia-executor
BRIDGE_BACK_SERVICE=betinasia-executor-bridge-back
BRIDGE_LAY_SERVICE=betinasia-executor-bridge-lay
# Deploy Back-only: desative o check/restart do bridge lay para evitar FAIL falso.
# Exemplo:
# BRIDGE_LAY_SERVICE=0
#
# Janela do monitor
OPS_TELEMETRY_MAX_AGE_SEC=600
OPS_FAILS_TO_RESTART=2
OPS_RESTART_COOLDOWN_SEC=1800
OPS_MAX_RESTARTS_PER_HOUR=2
# Compatibilidade de CLI: se 0 (default), ignora argumentos desconhecidos em vez de abortar.
# Útil quando o unit systemd tem flags antigas/novas fora de sincronia.
OPS_MONITOR_STRICT_ARGS=0
# Tag opcional para prefixo das mensagens Telegram (ex.: ops-monitor / ops-autopilot)
OPS_TELEGRAM_SOURCE=
#
# Heurística por JSONL do executor
OPS_EXECUTOR_TAIL_LINES=5000
OPS_EXECUTOR_TAIL_BYTES=2000000
OPS_EXECUTOR_MIN_EVENTS=30
# Se não houver eventos não-heartbeat por >X segundos *e* houver audits recentes, considera FAIL
OPS_EXECUTOR_NONHEARTBEAT_MAX_AGE_SEC=900
OPS_EXECUTOR_IDLE_MIN_AUDITS=10
# FAIL de idle só dispara com no mínimo este volume de "accepted" no bridge
# (evita falso positivo quando policy filtra quase tudo).
OPS_EXECUTOR_IDLE_MIN_ACCEPTED=1
# Se 1, quando bridge_accepted=0 o monitor trata ausência de non-heartbeat como idle esperado (PASS).
OPS_EXECUTOR_IDLE_EXPECTED_WHEN_ZERO_ACCEPTED=1
# Se 1, sem non-heartbeat fora da condição acima gera WARN; se 0, vira PASS informativo.
OPS_EXECUTOR_IDLE_WARN_ON_NO_NONHEARTBEAT=1
# Taxa de falhas (API_FAILED/NO_SESSION/INTERNAL_ERROR) em eventos não-heartbeat
OPS_EXECUTOR_FAIL_RATE_WARN=0.20
OPS_EXECUTOR_FAIL_RATE_FAIL=0.40
# Verificação ativa do endpoint /health do executor (ready/workers)
OPS_EXECUTOR_HEALTH_ENABLE=1
OPS_EXECUTOR_HEALTH_REQUIRE_READY=1
OPS_EXECUTOR_HEALTH_MIN_WORKERS=1
OPS_EXECUTOR_HEALTH_UNIX_SOCKET=/tmp/betinasia-exec.sock
OPS_EXECUTOR_HEALTH_HTTP_URL=http://127.0.0.1:8089
OPS_EXECUTOR_HEALTH_TIMEOUT_SEC=3

# Latência (ms) no executor JSONL (timing.*). Dispara WARN/FAIL quando p50/p90 excedem thresholds.
# Útil para detectar degradação por proxy/Playwright/timeout sem precisar olhar o PDF manualmente.
OPS_EXECUTOR_LAT_MIN_EVENTS=30
OPS_EXECUTOR_LAT_CALL_P50_WARN_MS=12000
OPS_EXECUTOR_LAT_CALL_P50_FAIL_MS=20000
OPS_EXECUTOR_LAT_POST_P50_WARN_MS=7000
OPS_EXECUTOR_LAT_POST_P50_FAIL_MS=12000
OPS_EXECUTOR_LAT_QUEUE_P50_WARN_MS=1000
OPS_EXECUTOR_LAT_QUEUE_P50_FAIL_MS=3000
# Opcional: thresholds por p90 de call_to_done_ms (0=desliga)
OPS_EXECUTOR_LAT_CALL_P90_WARN_MS=0
OPS_EXECUTOR_LAT_CALL_P90_FAIL_MS=0
# Em amostra baixa de OKs, ainda alerta quando latência estiver claramente alta.
OPS_EXECUTOR_LAT_LOW_SAMPLE_MIN_EVENTS=5
# Se 1, pode elevar para FAIL em amostra baixa quando bater threshold de FAIL.
# Se 0 (default), em amostra baixa vira WARN para evitar ação agressiva por poucos pontos.
OPS_EXECUTOR_LAT_LOW_SAMPLE_FAIL_HARD=0
# Em amostra ultra-baixa (1-4 eventos), alerta por outlier extremo de p50 call_to_done.
# Use 0 para desabilitar.
OPS_EXECUTOR_LAT_SINGLE_EVENT_WARN_MS=20000
OPS_EXECUTOR_LAT_SINGLE_EVENT_FAIL_MS=35000
# Degradação relativa (janela recente vs baseline no tail histórico do executor_jsonl)
OPS_EXECUTOR_LAT_DEGRADE_ENABLE=1
OPS_EXECUTOR_LAT_DEGRADE_MIN_RECENT_EVENTS=5
OPS_EXECUTOR_LAT_DEGRADE_MIN_BASE_EVENTS=30
OPS_EXECUTOR_LAT_DEGRADE_BASE_LOOKBACK_EVENTS=300
OPS_EXECUTOR_LAT_DEGRADE_WARN_RATIO=1.40
OPS_EXECUTOR_LAT_DEGRADE_FAIL_RATIO=1.80
OPS_EXECUTOR_LAT_DEGRADE_WARN_DELTA_MS=2500
OPS_EXECUTOR_LAT_DEGRADE_FAIL_DELTA_MS=5000

# Auto-pilot: se latência der FAIL, (opcionalmente) pausa bridges ao invés de ficar restartando em loop.
# Default recomendado: 0 (não pausar automaticamente; apenas alertar via Telegram e agir manualmente).
OPS_LATENCY_FAIL_PAUSE_BRIDGES=0
# Quantos FAILs consecutivos de latência (executor) antes de pausar bridges
OPS_LATENCY_FAIL_PAUSE_BRIDGES_FAILS=1
# Cooldown (s) entre ações de pause (para não spammar systemd)
OPS_LATENCY_FAIL_PAUSE_COOLDOWN_SEC=1800
# Rate limit: máximo de "pause" por hora (por serviço bridge)
OPS_LATENCY_FAIL_PAUSE_MAX_PER_HOUR=1
# Se 1, evita restart do executor quando o FAIL for de latência (preferimos pausar bridges e investigar)
OPS_LATENCY_FAIL_SKIP_RESTART=1
# Refresh opcional por degradação persistente de latência (WARN/FAIL), com proteção de cooldown/rate-limit.
# 0=desliga (default). Quando 1, reinicia serviços-alvo após N alertas consecutivos.
OPS_LATENCY_DEGRADE_REFRESH_ENABLE=0
OPS_LATENCY_DEGRADE_REFRESH_ALERTS=3
OPS_LATENCY_DEGRADE_REFRESH_COOLDOWN_SEC=1800
OPS_LATENCY_DEGRADE_REFRESH_MAX_PER_HOUR=1
# CSV de serviços para refresh (se vazio, usa AUDIT_SERVICE e BRIDGE_BACK_SERVICE).
OPS_LATENCY_DEGRADE_REFRESH_SERVICES=

# FAIL duro quando o audit fica sem avançar no DB apesar de upstream ativo.
# 0=desliga (default conservador), >0 ativa limiar em segundos.
OPS_AUDIT_DB_STALE_FAIL_SEC=0
OPS_AUDIT_DB_STALE_MIN_UPSTREAM=10

# Fluxo audit -> bridge (detecção de travamento funcional de handoff)
OPS_BRIDGE_FLOW_ENABLE=1
OPS_BRIDGE_FLOW_WINDOW_MINUTES=30
OPS_BRIDGE_FLOW_MIN_ELIGIBLE=20
OPS_BRIDGE_FLOW_FAIL_ON_ZERO=1
OPS_BRIDGE_FLOW_SEEN_RATIO_WARN=0.50
OPS_BRIDGE_FLOW_SEEN_RATIO_FAIL=0.20
# Defaults de filtro/ação (podem herdar BRIDGE_* se vazio)
OPS_BRIDGE_ACTION=
OPS_BRIDGE_HYPOTHESIS=H3B
OPS_BRIDGE_PREMATCH_ONLY=
OPS_BRIDGE_SOURCE_STATUSES=
OPS_BRIDGE_SOURCE_AUDIT_VERSIONS=

# Throughput e composição de motivos no bridge (observabilidade operacional)
OPS_BRIDGE_THROUGHPUT_ENABLE=0
OPS_BRIDGE_THROUGHPUT_MIN_SEEN=60
OPS_BRIDGE_ACCEPTED_WARN_PCT=0.08
OPS_BRIDGE_ACCEPTED_FAIL_PCT=0.03
# 0=rebaixa FAIL para WARN (evita restart automático por política/mercado)
OPS_BRIDGE_THROUGHPUT_FAIL_HARD=0
OPS_BRIDGE_FLOW_POLICY_AS_WARN=1
OPS_BRIDGE_FLOW_POLICY_RATIO_MIN=0.80
OPS_BRIDGE_FLOW_POLICY_REASONS=not_active,wf_ah_max_abs_line,min_limit,disabled_back,disabled_lay

# Login (proxy-friendly)
BETINASIA_LOGIN_POST_WAIT_SEC=12
BETINASIA_MOLLY_CLIENT_VERSION=2.5.54

# ===========================================
# EXECUTOR BRIDGE (Audit -> Executor)
# ===========================================
# Comece em shadow (is_live=false) e só depois ligue live.
BRIDGE_MODE=shadow
BRIDGE_EXEC_SIDE=Back
BRIDGE_STAKE=3.0
BRIDGE_POLL_SEC=2.0
BRIDGE_LOOKBACK_SEC=120
BRIDGE_MAX_PER_CYCLE=3
# Se 1 (default), prioriza sinais mais novos (audited_at DESC) para reduzir latência.
# Use 0 apenas para modo legado de processamento por antiguidade.
BRIDGE_FETCH_NEWEST_FIRST=1
# Hipótese operada pelo bridge (ex.: H3B ou DT).
BRIDGE_HYPOTHESIS=H3B
BRIDGE_PREMATCH_ONLY=1
# Fase 1 (fast-path): filtra origem por versão/status do audit para usar ws_gate_back
# como feed de execução, mantendo audit API em paralelo apenas para observabilidade.
# Exemplo recomendado:
# BRIDGE_SOURCE_AUDIT_VERSIONS=v5.3-ws-gate-back
# BRIDGE_SOURCE_STATUSES=OK
BRIDGE_SOURCE_AUDIT_VERSIONS=
BRIDGE_SOURCE_STATUSES=

# (opcional) Policy OOS (walk-forward) exportado pelo relatório.
# Gere com: analyze_contexto_operacao_b808_robust_report.py --walkforward --wf-export-policy-json /caminho/policy.json
BRIDGE_POLICY_JSON=
BRIDGE_POLICY_RELOAD_SEC=5.0
# Se `WF_KEY_BY_LEAGUE=1` estiver ativo no export e você quiser ignorar liga operacionalmente:
BRIDGE_POLICY_USE_BASE=0

# (opcional) Guardrail simples por liquidez (proxy = betslip_limit em USD)
BRIDGE_MIN_LIMIT=0.0

# (opcional) Engine dinâmico de sizing por jogo (match_budget do WF exportado na policy JSON).
# Quando ligado, o bridge calcula stake/liability por sinal usando:
# - budgets do WF: budget_back_frac / budget_lay_frac / budget_cap_signal_frac / budget_risk_mode
# - banca vigente (via accounting_daily_report.json ou override)
BRIDGE_USE_WF_BUDGET=0
# Fonte de banca (arquivo gerado pelo betinasia-accounting-daily.service):
BRIDGE_BANKROLL_JSON=logs/accounting_daily_report.json
BRIDGE_BANKROLL_RELOAD_SEC=30.0
# Override manual (se setar, prevalece como referência de sizing):
# BRIDGE_BANKROLL_REF=1000

# (recomendado) Saldo para guardrail operacional (alerta/bloqueio) — separado do bankroll_ref do sizing.
# Use este quando você quer sizing fixo (BRIDGE_BANKROLL_REF) mas o bloqueio/alerta baseado no saldo real dos CSVs.
BRIDGE_BALANCE_JSON=logs/accounting_daily_report.json
BRIDGE_BALANCE_RELOAD_SEC=30.0
# Estimativa de #sinais por jogo para modes signals_sqrt/signals_linear (janela curta):
BRIDGE_SIGNALS_LOOKBACK_H=36.0
# Override manual do risk_mode do WF (não depende do daily/policy):
# BRIDGE_WF_RISK_MODE_OVERRIDE=signals_sqrt
# Overrides manuais dos parâmetros numéricos de risco/caps (separado do daily):
# Crie um arquivo JSON (ex.: logs/bridge_risk_params.json) e aponte aqui para poder ajustar
# sem depender do wf_policy_current.json:
BRIDGE_RISK_PARAMS_JSON=
BRIDGE_RISK_PARAMS_RELOAD_SEC=5.0

# Guardrail operacional: saldo disponível (monitorado via /account do executor, usando a sessão logada).
# Regras (pedido go-live):
# - Se saldo < 500: envia alerta no Telegram (não bloqueia novas apostas)
# - Se saldo <= 50: bloqueia novas apostas (pula no bridge e grava motivo no DB)
BRIDGE_BALANCE_CHECK_SEC=20
BRIDGE_MIN_BALANCE_ALERT_USD=500
BRIDGE_MIN_BALANCE_BLOCK_USD=50
BRIDGE_BALANCE_ALERT_COOLDOWN_SEC=1800
BRIDGE_BALANCE_ALERT_TELEGRAM=1
# Se 1, aplica guard mesmo em BRIDGE_MODE=shadow (útil para teste). Default: 0.
BRIDGE_BALANCE_GUARD_IN_SHADOW=0
# Opcional: parâmetros adicionais para sizing base por liquidez (betslip_limit).
# - stake_pct_of_limit: usa X% do betslip_limit como base antes do budget (default=1.0).
# - stake_cap_abs: teto absoluto (USD) para essa base (0=sem teto).
# Exemplo no JSON: {"stake_pct_of_limit": 1.0, "stake_cap_abs": 0}
# Também suportamos caps ABSOLUTOS por aposta (útil para operar com "stake médio" fixo):
# - cap_lay_pre_abs: cap absoluto (USD) de liability por sinal no Lay pre-match
# - cap_lay_in_abs : cap absoluto (USD) de liability por sinal no Lay in-match
# - cap_back_pre_abs / cap_back_in_abs: cap absoluto (USD) de stake por sinal no Back
# - disable_back / disable_lay: kill-switch por lado (true/false)
# - slippage_gate_lay_in_delta_pct_gt: se definido (>0), ativa gate no executor: bloqueia LIVE se delta_pct > limiar (Lay + is_live)
# - slippage_gate_back_in_max_adverse_delta_pct: se definido (>0), ativa gate no executor: bloqueia LIVE se delta_pct < -limiar (Back + is_live)
# Também suporta guardrail de saldo via risk_params_json (override das env vars acima):
# - min_balance_alert_usd (default 500)
# - min_balance_block_usd (default 50)
# - balance_check_sec (default 20)
# - balance_alert_cooldown_sec (default 1800)
# - balance_alert_telegram (default 1)
# Guardrail adicional: cap por jogo como % da banca (0=off). Back em stake; Lay em liability.
BRIDGE_CAP_EVENT_BACK_FRAC=0.0
BRIDGE_CAP_EVENT_LAY_FRAC=0.0

# ===========================================
# EXECUTOR (LIVE): guardrails adicionais
# ===========================================
# Cap de slippage para Lay in-match (delta_pct vs odd_at_decision). 0=desliga.
EXECUTOR_SLIPPAGE_GATE_LAY_IN_MAX_PCT=0
# Se 1, bloqueia se delta_pct não estiver disponível (fail-closed).
EXECUTOR_SLIPPAGE_GATE_LAY_IN_FAIL_CLOSED=0

# Cap de slippage para Back in-match (delta_pct vs odd_at_decision). 0=desliga.
# IMPORTANTE: para Back, slippage adverso é odds CAINDO. O gate bloqueia se delta_pct < -thr.
EXECUTOR_SLIPPAGE_GATE_BACK_IN_MAX_PCT=0
# Se 1, bloqueia se delta_pct não estiver disponível (fail-closed).
EXECUTOR_SLIPPAGE_GATE_BACK_IN_FAIL_CLOSED=0

# ===========================================
# ACCOUNTING monitor (saldo + P&L via CSV)
# ===========================================
ACCOUNTING_POLL_SEC=300
ACCOUNTING_OUT_DIR=logs/accounting
ACCOUNTING_JSONL=logs/accounting_snapshots.jsonl

# ===========================================
# DAILY FULL REPORT (OOS + execution + accounting + PDF + Telegram)
# ===========================================
DAILY_REPORT_TELEGRAM=1
DAILY_REPORT_OUT_DIR=logs/daily_reports
DAILY_REPORT_MODE=oos_first
DAILY_OOS_HYPOTHESIS_TYPE=H3B
DAILY_OOS_DIRECTION=up
DAILY_OOS_VERSIONS=v4.0-api,v5.0-ws-only,v5.1-ws-gate-lay
# (opcional) auditoria API back-only para alimentar execução Back
# DAILY_OOS_VERSIONS=v4.0-api,v5.2-api-back,v5.1-ws-gate-lay
DAILY_OOS_LOOKBACK_DAYS=21
# Guardrail anti-superestimação: ROI por placar só com jogo finalizado.
ROI_REQUIRE_FINISHED=1
OOS_ADHERENCE_ROI_REQUIRE_FINISHED=1
# ===========================================
# DAILY DT REPORT (segundo daily dedicado para DT)
# ===========================================
# Runner: python -m ops.daily_dt_report
DAILY_DT_REPORT_TELEGRAM=1
DAILY_DT_REPORT_OUT_DIR=logs/daily_reports_dt
DAILY_DT_OOS_HYPOTHESIS_TYPE=DT
DAILY_DT_OOS_DIRECTION=down
DAILY_DT_OOS_VERSIONS=v5.3-ws-gate-back
# Por padrão, DT NÃO publica policy_current global (evita sobrescrita de H3B).
DAILY_DT_WF_PUBLISH_CURRENT=0

# Se 1, não remove dias “auto-excluídos” (útil para enxergar janelas até o fim mesmo com betslip=0 em alguns dias)
DAILY_NO_AUTO_EXCLUDE_DAYS=0
# Walk-forward defaults alinhados com o reporte “v38” (expanding + leaguePre + AHgatePre)
DAILY_WF_TRAIN_MODE=expanding
DAILY_WF_TRAIN_DAYS=2
DAILY_WF_TEST_DAYS=2
DAILY_WF_STEP_DAYS=2
DAILY_WF_KEY_BY_LEAGUE=1
DAILY_WF_KEY_BY_LEAGUE_SCOPE=pre
# Restringe quais lados o walk-forward pode selecionar.
# Para H3B UP operacional atual, recomendamos policy em Back-only.
# Opções: both|lay|back
DAILY_WF_SIDES=back
# Restringe o regime temporal do WF.
# Para bridge PREMATCH_ONLY, recomenda-se usar pre para evitar "contaminação" por In.
# Opções: both|pre|in
DAILY_WF_REGIMES=pre
# Filtro opcional para cenário Back Pre Fast/Slippage no WF:
# - slip_max: mantém apenas Back Pre com slippage <= limite
# - slip_field: slippage_pre_pct (quando disponível) ou diff_pct (proxy)
# - fast_max_lag_ms: mantém apenas Back Pre com lag_total_ms <= limite (proxy de "fast")
# Exemplos:
# DAILY_WF_BACKPRE_SLIP_MAX=0
# DAILY_WF_BACKPRE_SLIP_FIELD=diff_pct
# DAILY_WF_BACKPRE_FAST_MAX_LAG_MS=5000
DAILY_WF_BACKPRE_SLIP_MAX=
DAILY_WF_BACKPRE_SLIP_FIELD=diff_pct
DAILY_WF_BACKPRE_FAST_MAX_LAG_MS=
DAILY_WF_AH_MAX_ABS_LINE=2.0
DAILY_WF_AH_SCOPE=pre
DAILY_WF_LIQUIDITY_MODE=none
DAILY_WF_LIQUIDITY_SCOPE=pre
DAILY_WF_MIN_MATCHES=0
# Regra de ativação das combinações pre-match no WF:
# - roi_clv: ROI + gate de CLV quando ROI não-significativo (modo atual)
# - roi_only: seleção apenas por ROI (sem gate de CLV)
DAILY_WF_PRE_ACTIVATION_MODE=roi_clv
# ROI mínimo (%) para ativação no WF (ex.: 2 => exige ROI>2% para ativar)
DAILY_WF_ROI_MIN_ACTIVATE=0
DAILY_WF_SHRINKAGE=1
DAILY_WF_EXCLUDE_EXEC_BUCKETS_BACK=10-20s
# (opcional) excluir buckets ruins apenas para Lay no WF (walk-forward)
DAILY_WF_EXCLUDE_EXEC_BUCKETS_LAY=

# (opcional) Overrides do WF (rodagem manual): sizing + budget por jogo
# Útil para simular in-match “governado por budget/caps/limits”, setando FLAT enorme no IN,
# sem precisar alterar a política operacional nem o agendado das 19h.
# Exemplos:
# DAILY_WF_SCHEME_PRE=KELLY_0.25
# DAILY_WF_SCHEME_IN=FLAT
# DAILY_WF_FLAT_STAKE_BACK=1000000000
# DAILY_WF_FLAT_LIAB_LAY=1000000000
# Budget por match_id (EQ 4%/4% cap33%, risk_mode=fixed):
# DAILY_WF_BUDGET_BACK_FRAC=0.04
# DAILY_WF_BUDGET_LAY_FRAC=0.04
# DAILY_WF_BUDGET_CAP_SIGNAL_FRAC=0.33
# DAILY_WF_BUDGET_RISK_MODE=fixed
DAILY_WF_SCHEME_PRE=
DAILY_WF_SCHEME_IN=
DAILY_WF_FLAT_STAKE_BACK=
DAILY_WF_FLAT_LIAB_LAY=50
DAILY_WF_BUDGET_BACK_FRAC=
DAILY_WF_BUDGET_LAY_FRAC=
DAILY_WF_BUDGET_CAP_SIGNAL_FRAC=
DAILY_WF_BUDGET_RISK_MODE=

# (opcional) Sweep rápido de "stake médio" (caps absolutos por aposta) no OOS:
# adiciona uma seção extra no PDF com curvas lucro×cap (1D + grid 2D in-match) e exporta CSVs.
DAILY_WF_SWEEP_STAKES=0

# ===========================================
# Daily report — tese Back Pre fast (pre_submit_ms) + robustez (bootstrap)
# ===========================================
# Esses knobs controlam o bloco:
# "Tese: Back Pre fast (pre_submit_ms) — sizing (stake HI vs LO), P&L e robustez (accounting; order_id)"
#
# Quantidade de reamostragens do bootstrap para IC90/IC95 do ROI mean por ordem (grupos fast/slow).
DAILY_BACKPRE_FAST_BOOTSTRAP_N=2000
# Mínimo de ordens em um grupo para imprimir ICs (evita ler “sinais” com amostra minúscula).
DAILY_BACKPRE_FAST_MIN_ORDERS=25

# Início da transição de regra da tese (data UTC, YYYY-MM-DD).
# A partir desta data (inclusive), o report usa o critério "novo":
#   - pre_submit_ms <= EXECUTOR_BACKPRE_FAST_MAX_PRE_SUBMIT_MS (normalmente 5000)
#   - stake HI conforme DAILY_BACKPRE_FAST_HI_MIN/HI_MAX
# Antes desta data, usa o critério "antigo":
#   - pre_submit_ms <= DAILY_BACKPRE_FAST_OLD_MAX_PRE_SUBMIT_MS (padrão 6000)
#   - stake HI em [DAILY_BACKPRE_FAST_OLD_HI_MIN, DAILY_BACKPRE_FAST_OLD_HI_MAX]
# Se vazio, o report usa apenas o critério novo em toda a janela.
DAILY_BACKPRE_FAST_THESIS_START_DAY=2026-04-21
# Critério novo (desde DAILY_BACKPRE_FAST_THESIS_START_DAY):
# - HI: stake > DAILY_BACKPRE_FAST_HI_MIN
# - se DAILY_BACKPRE_FAST_HI_MAX estiver vazio, não aplica teto superior.
DAILY_BACKPRE_FAST_HI_MIN=5.0
DAILY_BACKPRE_FAST_HI_MAX=
# Critério antigo (antes de DAILY_BACKPRE_FAST_THESIS_START_DAY):
DAILY_BACKPRE_FAST_OLD_MAX_PRE_SUBMIT_MS=6000
DAILY_BACKPRE_FAST_OLD_HI_MIN=5.0
DAILY_BACKPRE_FAST_OLD_HI_MAX=14.0
DAILY_WF_SWEEP_BACK_CAPS=0,5,10,20,30,50,75,100,150,200
DAILY_WF_SWEEP_LAY_CAPS=0,10,20,30,50,75,100,150,200,300
DAILY_WF_SWEEP_GRID_IN=1

DAILY_KELLY_BANKROLL=10000
# (opcional) se vazio, usa default do script (10k,20k,30k,50k,100k quando kelly_bankroll setado)
# Exemplo com bancas altas:
# DAILY_WF_BANKROLL_GRID=10000,50000,100000,500000,1000000,1500000,3000000,5000000
DAILY_WF_BANKROLL_GRID=
DAILY_WF_POLICY_CURRENT=logs/wf_policy_current.json
DAILY_WF_POLICY_HISTORY_DIR=logs/policy_history
DAILY_WF_POLICY_HISTORY_JSONL=logs/wf_policy_history.jsonl
# Se 1, atualiza DAILY_WF_POLICY_CURRENT após OOS OK; se 0, só gera relatório/local artifacts.
DAILY_WF_PUBLISH_CURRENT=1
# Guardrail de compatibilidade da policy com o modo operacional do bridge.
# Recomendado: enable=1 + fail_closed=1 para evitar publicar carteira incompatível com PREMATCH_ONLY.
DAILY_WF_COMPAT_GUARD_ENABLE=1
DAILY_WF_COMPAT_FAIL_CLOSED=1
# Quando PREMATCH_ONLY=1, exige no mínimo N chaves *_Pre_* para o lado ativo.
DAILY_WF_COMPAT_MIN_PRE_KEYS=1
# Override opcional (se vazio, herdado de BRIDGE_EXEC_SIDE/BRIDGE_PREMATCH_ONLY).
# DAILY_WF_COMPAT_BRIDGE_EXEC_SIDE=Back
# DAILY_WF_COMPAT_PREMATCH_ONLY=1
DAILY_EXEC_KPI_LAST=50000

# (opcional) Visibilidade mínima por tipo (Back/Lay × Pre/In) na seção 1 do PDF.
# Janela curta em horas a partir do executor_jsonl + placares (matches) quando disponíveis.
DAILY_EXEC_MIN_BY_TYPE_HOURS=24
# Por padrão focamos em apostas reais (LIVE_OK). Para incluir shadow: LIVE_OK,DRY_OK
DAILY_EXEC_MIN_BY_TYPE_ONLY_STATUS=LIVE_OK
# Se 1, usa P&L real via endpoint /account (orders.profit_loss), sem depender de placar.
DAILY_EXEC_MIN_BY_TYPE_ORDERS_PNL=1
# Page size usado ao buscar orders no /account (precisa cobrir a janela curta).
DAILY_EXEC_MIN_BY_TYPE_ORDERS_PAGE_SIZE=200

# ===========================================
# DAILY — Contrafactuais de slippage (placar)
# ===========================================
# Controla onde o gate de slippage é aplicado no contrafactual do relatório (não afeta o executor/portfolio).
# Valores: all | pre | in
SLIPPAGE_GATE_BACK_SCOPE=all
SLIPPAGE_GATE_LAY_SCOPE=pre

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/betinasia_bot.log

# ===========================================
# AMBIENTE
# ===========================================
# development, staging, production
ENVIRONMENT=development

# ===========================================
# AUDIT API (H3B/DT) — Gate WS(t0,t+5) -> abre LAY sob cap
# ===========================================
# Modo do audit_h3b_api.py:
# - api        : WS detecta + abre BACK/LAY via betslip (alto custo/rate limit)
# - ws_only    : só WS (não abre ticket)
# - ws_gate_lay: só abre ticket LAY quando houver queda forte em 5s (recomendado)
AUDIT_MODE=ws_gate_lay
# Rótulo salvo no betslip_audit_results.hypothesis_type (ex.: H3B, DT).
AUDIT_HYPOTHESIS_TYPE=H3B
# DT (Downward Trend): K quedas consecutivas sem reversão
# - cada passo precisa cair pelo menos DT_MIN_STEP_DROP_PCT (%)
# - queda acumulada da sequência precisa atingir DT_MIN_CUM_DROP_PCT (%)
DT_MIN_CONSEC_DOWNS=3
DT_MIN_STEP_DROP_PCT=0.20
DT_MIN_CUM_DROP_PCT=0.80
DT_MAX_STEP_GAP_SEC=30
DT_SIGNAL_COOLDOWN_SEC=45
AUDIT_API_SIDES=both

# Coalescência no enqueue (modo api; lados back/both):
# usa chave operacional compatível com o bridge para reduzir backlog/dup_key
# antes de consumir worker/API.
AUDIT_PREFILTER_ENABLE=1
AUDIT_PREFILTER_ENQUEUE_DEDUP=1
AUDIT_PREFILTER_BRIDGE_MODE=live
AUDIT_PREFILTER_LOCAL_KEY_TTL_SEC=21600
AUDIT_PREFILTER_LOCAL_KEY_MAX=200000

# Fast PMM específico do audit (não depende do env do executor).
AUDIT_FAST_PMM=1
AUDIT_PMM_TIMEOUT_SEC=1.2
AUDIT_PMM_MIN_WAIT_SEC=0.0
AUDIT_PMM_IDLE_TIMEOUT_SEC=0.15
AUDIT_BETSLIP_ID_TIMEOUT_SEC=2.0
AUDIT_BETSLIP_POST_TIMEOUT_MS=7000
AUDIT_BETSLIP_REFRESH_TIMEOUT_MS=7000

# Gate: WS(t+offset) < ratio * WS(t0)
GATE_DROP_OFFSET_SEC=5
GATE_DROP_RATIO=0.98

# Gate Back (ws_gate_back): mede ws(t0,t+5,t+10) em paralelo.
# Filtro de subida (t0->t+5) fica DESLIGADO por padrao para analise estatistica.
GATE_RISE_OFFSET_SEC=5
GATE_RISE_RATIO=1.02
GATE_BACK_ENFORCE_RISE_FILTER=0
GATE_BACK_MEASURE_OFFSETS_SEC=0,5,10
# Se AUDIT_TEMPORAL_WORKERS=0, o modo ws_gate_back forca este minimo para
# viabilizar coleta assíncrona sem bloquear o T+0.
AUDIT_GATE_BACK_ASYNC_MEASURE_WORKERS=1

# Modo legado (filtro ligado): pode preabrir betslip BACK em paralelo ao gate WS.
GATE_BACK_PREFETCH_BETSLIP=1
GATE_BACK_PREFETCH_SETTLE_TIMEOUT_SEC=0.25

# Tolerancia de atraso para gate: 0 desliga o corte por "stale".
GATE_MAX_LATE_SEC=0

# Cap de aberturas (POST /v1/betslips/) — conservador para evitar throttling
GATE_OPEN_WINDOW_SEC=300
GATE_OPEN_MAX=3

# Opcional: após abrir ticket LAY, coletar pontos via refresh
# (isso aumenta chamadas; use com parcimônia)
# GATE_LAY_REFRESH_TIMES_SEC=0,5,10,15,20

# ===========================================
# OOS (walk-forward) — export operacional
# ===========================================
# Path para export JSON (usado pelo Decision Engine/Bridge)
WF_EXPORT_POLICY_JSON=

# ===========================================
# OPS AI COPILOT (Camada B) — diagnóstico + fila de aprovação
# ===========================================
# Habilita serviço de copiloto IA via Telegram (requer TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID).
OPS_AI_MONITOR_ENABLE=1
# Intervalo de monitoramento automático (segundos).
OPS_AI_MONITOR_INTERVAL_SEC=180
# Janela padrão de diagnóstico para monitoramento automático (minutos).
OPS_AI_MONITOR_SINCE_MINUTES=30
# Envia mensagem automática quando novas sugestões pendentes forem criadas.
OPS_AI_NOTIFY_ON_NEW_PROPOSAL=1
# Arquivo de estado da fila (pendentes/histórico).
OPS_AI_STATE_FILE=logs/ops_ai_copilot_state.json
# Limite de sugestões pendentes em aberto.
OPS_AI_MAX_PENDING=30
# Timeout de execução por ação aprovada (segundos).
OPS_AI_ACTION_TIMEOUT_SEC=120
#
# Enriquecimento opcional por LLM externo (somente diagnóstico textual).
# Padrão: desabilitado (none).
OPS_AI_PROVIDER=none
# Exemplo quando habilitado:
# OPS_AI_PROVIDER=openai
# OPS_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPS_AI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPS_AI_TIMEOUT_SEC=25
