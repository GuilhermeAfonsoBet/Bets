# ============================================
# BETINASIA BOT - Configurações
# ============================================
# Copie este arquivo para .env e preencha os valores

# ===========================================
# BETINASIA - Credenciais de Login
# ===========================================
BETINASIA_USERNAME=seu_usuario_aqui
BETINASIA_PASSWORD=sua_senha_aqui

# ===========================================
# BANCO DE DADOS - PostgreSQL
# ===========================================
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://betbot:sua_senha_segura@localhost:5432/betinasia_bot

# ===========================================
# CACHE - Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# TELEGRAM - Alertas (opcional)
# ===========================================
# Crie um bot em @BotFather e obtenha o token
TELEGRAM_BOT_TOKEN=
# Seu chat ID (envie /start ao bot e veja o ID)
TELEGRAM_CHAT_ID=

# ===========================================
# PROXY RESIDENCIAL (para VPS em datacenter)
# ===========================================
# Necessário para evitar bloqueio de IP pelo BetinAsia
# Serviços: Bright Data, IPRoyal, Smartproxy, Oxylabs
# Exemplo proxy estático ISP:
# PROXY_SERVER=http://200.160.37.95:12323
# PROXY_USERNAME=seu_user_proxy
# PROXY_PASSWORD=sua_senha_proxy
PROXY_SERVER=http://brd.superproxy.io:33335
PROXY_USERNAME=brd-customer-XXXXX-zone-residential_proxy1
PROXY_PASSWORD=sua_senha_proxy

# ===========================================
# SCRAPING - Configurações
# ===========================================
# Intervalo entre scrapes (segundos)
SCRAPE_INTERVAL_TIER1=30
SCRAPE_INTERVAL_TIER2=120
SCRAPE_INTERVAL_TIER3=300

# Modo headless do browser (true para produção)
BROWSER_HEADLESS=true

# ===========================================
# SCORING - Modelo
# ===========================================
# Diretório dos modelos .joblib
MODELS_DIR=./models

# Cutoff de probabilidade para aprovar aposta
SCORING_CUTOFF=0.62

# ===========================================
# EXECUÇÃO - Apostas
# ===========================================
# Modo simulação (true = não aposta de verdade)
DRY_RUN=true

# Stake base em unidades
BASE_STAKE=10.0

# Stake máximo por aposta
MAX_STAKE=100.0

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/betinasia_bot.log

# ===========================================
# AMBIENTE
# ===========================================
# development, staging, production
ENVIRONMENT=development
