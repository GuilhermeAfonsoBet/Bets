[Unit]
Description=BetinAsia Results Updater - Atualiza resultados dos jogos
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
# Tenta usar venv local (betinasia_bot/venv) e faz fallback para ~/Bets/venv.
ExecStart=/bin/bash -lc 'cd /home/betbot/Bets/betinasia_bot && if [ -x ./venv/bin/python ]; then exec ./venv/bin/python -m results.auto_update_results; elif [ -x /home/betbot/Bets/venv/bin/python ]; then exec /home/betbot/Bets/venv/bin/python -m results.auto_update_results; else exec /usr/bin/python3 -m results.auto_update_results; fi'
Restart=always
RestartSec=300

# Logs
StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/results_updater.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/results_updater_error.log

# Limites
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

# Recursos
MemoryMax=512M

[Install]
WantedBy=multi-user.target
