[Unit]
Description=BetinAsia Auto Sync Results - Sincroniza matches e busca resultados
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
Environment="PATH=/home/betbot/Bets/betinasia_bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStart=/home/betbot/Bets/betinasia_bot/venv/bin/python -m results.auto_sync_results
Restart=always
RestartSec=300

StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/sync_results.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/sync_results_error.log

TimeoutStopSec=60
KillMode=mixed
MemoryMax=512M

[Install]
WantedBy=multi-user.target
