[Unit]
Description=BetinAsia H3B Audit (WS reversal Lay) - abre LAY no reversal (sem gate t+5)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment="PATH=/home/betbot/Bets/betinasia_bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:99"
Environment="PYTHONUNBUFFERED=1"

# Reversal Lay abre betslip; mantenha conservador para evitar 403/ratelimit.
Environment="AUDIT_EXECUTOR_WORKERS=1"
Environment="AUDIT_TEMPORAL_WORKERS=0"
Environment="AUDIT_MAX_QUEUE_DEPTH=50"
Environment="AUDIT_MAX_QUEUE_WAIT_MS=20000"
Environment="AUDIT_MODE=ws_reversal_lay"

# Cap de aberturas (POST /v1/betslips/)
Environment="GATE_OPEN_WINDOW_SEC=300"
Environment="GATE_OPEN_MAX=3"
Environment="GATE_MAX_LATE_SEC=2.5"

# Opcional: refresh temporal após abrir ticket
# Environment="GATE_LAY_REFRESH_TIMES_SEC=0,5,10,15,20"

ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStart=/home/betbot/Bets/betinasia_bot/venv/bin/python audit_h3b_api.py --direction up --mode ws_reversal_lay
Restart=always
RestartSec=60

StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/audit_ws_reversal_lay.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/audit_ws_reversal_lay_error.log

TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target

