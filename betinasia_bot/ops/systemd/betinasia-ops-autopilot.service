 [Unit]
 Description=BetinAsia Ops Auto-Pilot (safe restart + alert)
 After=network-online.target
 Wants=network-online.target
 
 [Service]
 Type=oneshot
 WorkingDirectory=/home/betbot/Bets/betinasia_bot
 EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
 ExecStart=/bin/bash -lc 'cd /home/betbot/Bets/betinasia_bot && if [ -x ./venv/bin/python ]; then exec ./venv/bin/python -m ops.health_monitor --since-minutes 30 --telegram --autopilot; else exec /usr/bin/python3 -m ops.health_monitor --since-minutes 30 --telegram --autopilot; fi'
 
