[Unit]
Description=BetinAsia H3BUP Daily V2 (shadow; fail-open; publish OFF)
After=network-online.target betinasia-daily-full-report.service
Wants=network-online.target

[Service]
Type=oneshot
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment=PYTHONUNBUFFERED=1
Environment=H3BUP_DAILY_V2_ENABLED=1
Environment=H3BUP_DAILY_V2_PUBLISH=0
Environment=H3BUP_DAILY_V2_COMPARE_V1=1
Environment=H3BUP_DAILY_V2_FAIL_OPEN=1
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs/daily_v2
ExecStart=/bin/bash -lc 'cd /home/betbot/Bets/betinasia_bot && ./venv/bin/python -m ops.daily_v2 --root /home/betbot/Bets/betinasia_bot --report-type DAILY_CLOSED'
StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/daily_v2_shadow.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/daily_v2_shadow_error.log
# Fail-open: never mark unit failed hard enough to cascade
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
