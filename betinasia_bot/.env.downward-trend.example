# ============================================
# BETINASIA BOT - Downward Trend (DT)
# ============================================
# Copie para .env na VPS DT e preencha os segredos localmente.
# NUNCA commite .env com senha, token Telegram ou proxy.

# BetinAsia - conta dedicada da estrategia DT
BETINASIA_USERNAME=seu_usuario_dt
BETINASIA_PASSWORD=sua_senha_dt

# Banco local da VPS DT
DATABASE_URL=postgresql://betbot:sua_senha_segura@localhost:5432/betinasia_dt

# Proxy dedicado da estrategia DT
PROXY_SERVER=http://HOST_DO_PROXY:PORTA
PROXY_USERNAME=usuario_do_proxy
PROXY_PASSWORD=senha_do_proxy

# Telegram separado para DT
TELEGRAM_BOT_TOKEN=token_do_bot_dt
TELEGRAM_CHAT_ID=chat_id_do_grupo_dt

# Executor
EXECUTOR_ALLOW_LIVE=0
EXECUTOR_WORKERS=1
EXECUTOR_UNIX_SOCKET=/tmp/betinasia-exec.sock
EXECUTOR_JSONL=logs/executor_live_dt.jsonl
EXECUTOR_FAST_PMM=1
EXECUTOR_PMM_TIMEOUT_SEC=0.8
EXECUTOR_PMM_MIN_WAIT_SEC=0.0
EXECUTOR_PMM_IDLE_TIMEOUT_SEC=0.12
EXECUTOR_BETSLIP_CACHE_MAX_KEYS=0

# Audit DT - Downward Trend
AUDIT_MODE=ws_gate_back
AUDIT_HYPOTHESIS_TYPE=DT
AUDIT_API_SIDES=back
AUDIT_EXECUTOR_WORKERS=2
AUDIT_TEMPORAL_WORKERS=0
AUDIT_MAX_QUEUE_DEPTH=200
AUDIT_MAX_QUEUE_WAIT_MS=20000

# Conceitualizacao inicial: 3 quedas consecutivas
DT_MIN_CONSEC_DOWNS=3
DT_MIN_STEP_DROP_PCT=0.20
DT_MIN_CUM_DROP_PCT=0.80
DT_MAX_STEP_GAP_SEC=30
DT_SIGNAL_COOLDOWN_SEC=45

# Gate Back DT: aprova no T+0 e mede serie WS em paralelo
GATE_RISE_OFFSET_SEC=5
GATE_RISE_RATIO=1.02
GATE_BACK_ENFORCE_RISE_FILTER=0
GATE_BACK_MEASURE_OFFSETS_SEC=0,5,10
AUDIT_GATE_BACK_ASYNC_MEASURE_WORKERS=1

# Bridge DT
BRIDGE_MODE=shadow
BRIDGE_EXEC_SIDE=Back
BRIDGE_HYPOTHESIS=DT
BRIDGE_POLICY_JSON=logs/wf_policy_current_dt.json
BRIDGE_PREMATCH_ONLY=1
BRIDGE_REQUIRE_POLICY=1
BRIDGE_POLL_SEC=0.25
BRIDGE_MAX_PER_CYCLE=10

# Relatorio/OOS DT isolado da policy H3B
DAILY_DT_OOS_HYPOTHESIS_TYPE=DT
DAILY_DT_OOS_DIRECTION=down
DAILY_DT_OOS_VERSIONS=v5.3-ws-gate-back
DAILY_DT_REPORT_OUT_DIR=logs/daily_reports_dt
DAILY_WF_POLICY_CURRENT=logs/wf_policy_current_dt.json
DAILY_WF_POLICY_HISTORY_DIR=logs/policy_history_dt
DAILY_WF_POLICY_HISTORY_JSONL=logs/wf_policy_history_dt.jsonl
