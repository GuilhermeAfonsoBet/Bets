[Unit]
Description=BetinAsia Accounting Daily Snapshot (CSV)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:99"
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs/accounting
ExecStart=/bin/bash -lc 'cd /home/betbot/Bets/betinasia_bot && if [ -x ./venv/bin/python ]; then exec ./venv/bin/python -m ops.accounting_daily_report --no-print; elif [ -x /home/betbot/Bets/venv/bin/python ]; then exec /home/betbot/Bets/venv/bin/python -m ops.accounting_daily_report --no-print; else exec /usr/bin/python3 -m ops.accounting_daily_report --no-print; fi'

StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/accounting_daily.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/accounting_daily_error.log

