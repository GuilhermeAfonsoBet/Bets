[Unit]
Description=BetinAsia H3B Fast Audit - Auditoria contínua com navegação direta
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
Environment="PATH=/home/betbot/Bets/betinasia_bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:99"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStart=/home/betbot/Bets/betinasia_bot/venv/bin/python fast_audit_continuous.py --direction up
Restart=always
RestartSec=60

# Logs
StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/fast_audit.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/fast_audit_error.log

# Limites
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
