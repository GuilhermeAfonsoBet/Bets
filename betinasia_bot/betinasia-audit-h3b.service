[Unit]
Description=BetinAsia H3B Audit - Auditoria contínua WebSocket vs Betslip
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment="PATH=/home/betbot/Bets/betinasia_bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:99"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStart=/home/betbot/Bets/betinasia_bot/venv/bin/python audit_h3b_betslip.py --continuous --num-audits 50 --direction up
Restart=always
RestartSec=60

# Logs
StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/audit_h3b.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/audit_h3b_error.log

# Limites
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

# Recursos
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
