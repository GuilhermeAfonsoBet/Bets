[Unit]
Description=BetinAsia Accounting Monitor (balance + open-stakes CSV)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=betbot
Group=betbot
WorkingDirectory=/home/betbot/Bets/betinasia_bot
EnvironmentFile=/home/betbot/Bets/betinasia_bot/.env
Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:99"
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs
ExecStartPre=/bin/mkdir -p /home/betbot/Bets/betinasia_bot/logs/accounting
ExecStart=/bin/bash -lc 'cd /home/betbot/Bets/betinasia_bot && if [ -x ./venv/bin/python ]; then exec ./venv/bin/python -m ops.accounting_monitor; elif [ -x /home/betbot/Bets/venv/bin/python ]; then exec /home/betbot/Bets/venv/bin/python -m ops.accounting_monitor; else exec /usr/bin/python3 -m ops.accounting_monitor; fi'

Restart=always
RestartSec=30

StandardOutput=append:/home/betbot/Bets/betinasia_bot/logs/accounting_monitor.log
StandardError=append:/home/betbot/Bets/betinasia_bot/logs/accounting_monitor_error.log

TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target

